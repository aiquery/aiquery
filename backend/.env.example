# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Knowledge Base JSON files live under backend/rag-indices/user_<id>/ (override absolute path if needed)
# RAG_INDICES_DIR=

# ─── LLM API Keys (server fallback when user has not saved keys in LLM Configuration) ─
# Only configure the keys for models you intend to use.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Active Sonnet (retired 3.5/3.7 snapshots — see Anthropic model deprecations)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Chart PNG resolution: SVG viewBox is scaled by this factor (1–4, default 2). Higher = sharper image, larger files.
# CHART_RASTER_SCALE=2

# Chat: one Knowledge Base retrieval per question (chunk count = RAG_CHAT_TOP_K, default 5) feeds SQL generation + structured interpretation — no second vector search on the happy path.
# RAG_CHAT_TOP_K=5
#
# Chat: LLM interpretation of query results (second LLM call after SQL runs; needs row data). Set to 0/false for fastest answers (short template only).
# CHAT_LLM_INTERPRETATION=1
#
# Chat: auto-generate chart on each answer (chart-planning LLM + render). Set to 0/false for text-only; use "Show chart" in UI to generate later.
# CHAT_AUTO_VIZ=1
# Legacy alias (some tools use this name):
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# ─── Google BigQuery ──────────────────────────────────────────────────────────
BIGQUERY_PROJECT_ID=your_gcp_project_id
BIGQUERY_DATASET_ID=your_dataset_id
# Path to your GCP service account key JSON file (optional if using ADC)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ─── Azure SQL ────────────────────────────────────────────────────────────────
AZURE_SQL_SERVER=myserver.database.windows.net
AZURE_SQL_DATABASE=mydatabase
AZURE_SQL_USER=sqladmin
AZURE_SQL_PASSWORD=MySecurePassword123!
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_CERT=false

# ─── Amazon Redshift ──────────────────────────────────────────────────────────
REDSHIFT_HOST=my-cluster.abc123.us-east-1.redshift.amazonaws.com
REDSHIFT_DATABASE=dev
REDSHIFT_USER=awsuser
REDSHIFT_PASSWORD=MyRedshiftPassword123!
REDSHIFT_PORT=5439
REDSHIFT_SSL=true
REDSHIFT_SCHEMA=public

# ─── Slack Bot ────────────────────────────────────────────────────────────────
# Required to enable the Slack bot
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Optional Slack defaults
SLACK_DEFAULT_DATASOURCE=bigquery        # bigquery | azuresql | redshift
SLACK_DEFAULT_MODEL=gemini-2-0-flash     # claude-3-7-sonnet | gemini-2-0-flash | gpt-4o-mini
SLACK_AUTO_EXECUTE=false                 # Set to true to auto-run queries in Slack
