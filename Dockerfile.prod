# Multi-stage build for AIquery (production-ready Cloud Run image)
# Uses pnpm lockfiles and builds frontend + backend in separate stages.

# Stage 1: Frontend Builder
# VITE_* vars must be set at BUILD time (Vite inlines them). Pass via: docker build --build-arg VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your_site_key
FROM node:22-bullseye-slim AS frontend-builder
ARG PNPM_VERSION=10.17.1
ARG VITE_CLOUDFLARE_TURNSTILE_SITE_KEY
ENV VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=$VITE_CLOUDFLARE_TURNSTILE_SITE_KEY
# Fail the build if site key is missing (so Cloud Build / trigger config is obviously wrong)
RUN if [ -z "$VITE_CLOUDFLARE_TURNSTILE_SITE_KEY" ]; then echo "ERROR: VITE_CLOUDFLARE_TURNSTILE_SITE_KEY build arg is empty. Set _VITE_CLOUDFLARE_TURNSTILE_SITE_KEY in your Cloud Build trigger Substitution variables."; exit 1; fi
WORKDIR /app/frontend
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY frontend/package.json frontend/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install
COPY frontend .
RUN pnpm run build

# Stage 2: Backend Builder
FROM node:22-bullseye-slim AS backend-builder
ARG PNPM_VERSION=10.17.1
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install
COPY tsconfig.json tsconfig.backend.json ./
COPY backend ./backend
RUN pnpm run build:backend

# Stage 3: Runtime
FROM node:22-bullseye-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# Install Python for visualization
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python-is-python3 \
  && rm -rf /var/lib/apt/lists/*

ARG PNPM_VERSION=10.17.1
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --prod --frozen-lockfile || pnpm install --prod

COPY --from=backend-builder /app/dist ./dist
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist
COPY --from=backend-builder /app/backend/visualization ./dist/backend/visualization

# Install Python visualization dependencies (if file exists)
RUN if [ -f dist/backend/visualization/requirements.txt ]; then pip3 install --no-cache-dir -r dist/backend/visualization/requirements.txt; fi

# Run as non-root user in production containers.
RUN groupadd -g 1001 nodejs && useradd -u 1001 -g nodejs -m nodeapp \
  && chown -R nodeapp:nodejs /app
USER nodeapp

EXPOSE 3000
CMD ["node", "dist/backend/server.js"]
